db_systems = {
  litellm = {
    compartment                 = "application"
    db_version                  = "14"
    display_name                = "litellm-postgresql"
    instance_count              = 2
    instance_memory_size_in_gbs = 32
    instance_ocpu_count         = 2
    shape                       = "PostgreSQL.VM.Standard.E5.Flex.2.32GB"
    credentials = {
      secret   = "database_password"
      username = "litellm"
    }
    management_policy = {
      backup_policy = {
        kind           = "DAILY"
        retention_days = 14
      }
    }
    network_details = {
      is_reader_endpoint_enabled = true
      nsgs                       = ["postgresql"]
      subnet                     = "data"
    }
    storage_details = {
      is_regionally_durable = true
      system_type           = "OCI_OPTIMIZED_STORAGE"
    }
  }
}

