# Replace the placeholders with a certificate for the hostname in
# dns.auto.tfvars. Keep the real file uncommitted because its private key is
# stored in Terraform state and sent to OCI Certificates.
certificates = {
  litellm = {
    compartment = "application"
    description = "Public TLS certificate for LiteLLM"
    name        = "litellm-public-tls"
    certificate_config = {
      cert_chain_pem             = "..."
      certificate_pem            = "..."
      config_type                = "IMPORTED"
      private_key_pem            = "..."
      private_key_pem_passphrase = "..."
    }
  }
}

